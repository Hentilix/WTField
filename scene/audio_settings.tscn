[node name="Modal" type="ColorRect" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.65)

[node name="Center" type="CenterContainer" parent="Modal"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1

[node name="Panel" type="PanelContainer" parent="Modal/Center"]
custom_minimum_size = Vector2(360, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("PanelStyle")

[node name="Content" type="VBoxContainer" parent="Modal/Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Modal/Center/Panel/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "音量设置"
horizontal_alignment = 1

[node name="MusicHeading" type="HBoxContainer" parent="Modal/Center/Panel/Content"]
layout_mode = 2

[node name="Label" type="Label" parent="Modal/Center/Panel/Content/MusicHeading"]
layout_mode = 2
size_flags_horizontal = 3
text = "音乐"

[node name="Value" type="Label" parent="Modal/Center/Panel/Content/MusicHeading"]
layout_mode = 2
text = "60%"

[node name="MusicSlider" type="HSlider" parent="Modal/Center/Panel/Content"]
custom_minimum_size = Vector2(0, 24)
layout_mode = 2
focus_neighbor_top = NodePath("../Close")
focus_neighbor_bottom = NodePath("../SFXSlider")
focus_next = NodePath("../SFXSlider")
focus_previous = NodePath("../Close")
value = 60.0
scrollable = false
