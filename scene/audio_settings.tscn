[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scene/audio_settings.gd" id="1"]

[sub_resource type="StyleBoxFlat" id="PanelStyle"]
content_margin_left = 28.0
content_margin_top = 24.0
